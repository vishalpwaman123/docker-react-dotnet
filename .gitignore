# =====================================================================
# Root .gitignore - covers both auth-app (React) and auth-api (.NET).
# Everything listed here is either generated by a build, installed by a
# package manager, or personal to one machine. None of it belongs in git:
# it can always be recreated with `npm install` / `dotnet build`.
# =====================================================================


# ---------------------------------------------------------------------
# auth-app (React / Node)
# ---------------------------------------------------------------------

# Installed packages. Huge, and rebuilt from package-lock.json.
auth-app/node_modules/

# Output of `npm run build`. The Docker image builds this itself.
auth-app/build/

# Test coverage reports.
auth-app/coverage/

# Yarn Plug'n'Play files, if that package manager is ever used.
auth-app/.pnp
auth-app/.pnp.js

# Machine-local environment overrides. NOTE: plain `.env` is deliberately
# NOT ignored - it holds REACT_APP_API_BASE_URL, which every developer
# needs and which contains no secret. Put anything private in .env.local.
auth-app/.env.local
auth-app/.env.*.local

# The old Create React App git repo, kept as a backup after auth-app was
# folded into this single root repository.
auth-app/.git-cra-backup/

# Package manager logs, written only when an install fails.
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ---------------------------------------------------------------------
# auth-api (.NET)
# ---------------------------------------------------------------------

# Compiled output and intermediate build files.
auth-api/bin/
auth-api/obj/

# Visual Studio's per-solution state: window layout, open tabs, cache.
auth-api/.vs/

# Per-developer project settings, e.g. the launch profile last used.
auth-api/*.user

# Local user secrets, if `dotnet user-secrets` is ever used here.
auth-api/**/secrets.json


# ---------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------

.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
